{$FORUM_DOMAIN} {
    encode zstd gzip

    handle /api/* {
        reverse_proxy backend:8000
    }

    handle /admin/* {
        reverse_proxy backend:8000
    }

    handle_path /media/* {
        root * /srv/media
        file_server
    }

    handle_path /static/* {
        root * /srv/static
        file_server
    }

    handle {
        reverse_proxy frontend:80
    }
}
