# Copy to .env.backup on the production server only; chmod 600 .env.backup.
# Choose a repository outside the VPS, for example a separate SFTP storage account.
RESTIC_REPOSITORY=sftp:backup-user@backup-host:/backups/nexus-arcana
RESTIC_PASSWORD_FILE=/home/forum/.config/nexus-arcana/restic-password
# Provider-specific credentials may be added here if using S3, B2, Azure or another backend.
