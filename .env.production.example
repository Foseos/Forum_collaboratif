# Copier dans .env.production sur le serveur, puis remplacer chaque valeur d'exemple.
# Ne jamais publier le fichier rempli ou partager les secrets dans une conversation.
FORUM_DOMAIN=nexus-arcana.fr
FORUM_URL=https://nexus-arcana.fr
DJANGO_SETTINGS_MODULE=config.settings.prod
SECRET_KEY=REMPLACER_PAR_UNE_LONGUE_CLE_ALEATOIRE
ALLOWED_HOSTS=nexus-arcana.fr
CSRF_TRUSTED_ORIGINS=https://nexus-arcana.fr
CORS_ALLOWED_ORIGINS=https://nexus-arcana.fr
DB_NAME=forum
DB_USER=forum_user
DB_PASSWORD=REMPLACER_PAR_UN_MOT_DE_PASSE_ALEATOIRE
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.resend.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=resend
EMAIL_HOST_PASSWORD=REMPLACER_PAR_LA_CLE_D_ENVOI
DEFAULT_FROM_EMAIL=Nexus Arcana <contact@nexus-arcana.fr>
